// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  // PENTING: Jangan ada baris 'url' di sini. Sudah pindah ke prisma.config.ts
}

// --- ENUMS ---

enum Role {
  OWNER
  ADMIN
}

enum UnitType {
  KG
  PCS
  LOAD
}

enum MachineStatus {
  IDLE
  WASHING
  OVERDUE
  BROKEN
}

enum StatusLaundry {
  PENDING
  WASHING
  DRYING
  IRONING
  DONE
  PICKED_UP
  VOID
}

enum PaymentStatus {
  UNPAID
  DP
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  QRIS
  DEBIT
  TRANSFER
}

enum ExpenseCategory {
  FOOD
  SOAP
  FUEL
  OTHER
}

enum InventoryLogType {
  PURCHASE
  USAGE
  ADJUSTMENT
}

enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT
}

// --- MODELS ---

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  pin_hash  String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true) @map("is_active")
  tokenVersion Int      @default(0) @map("token_version")
  createdAt DateTime @default(now()) @map("created_at")

  orders        Order[]        @relation("CashierOrders")
  shifts        Shift[]
  inventoryLogs InventoryLog[]

  @@map("users")
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  phone       String    @unique
  address     String?
  dob         DateTime?
  notes       String?
  totalSpend  Decimal   @default(0) @map("total_spend") @db.Decimal(15, 2)
  totalVisits Int       @default(0) @map("total_visits")
  lastVisitAt DateTime? @map("last_visit_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  orders Order[]

  @@map("customers")
}

model Service {
  id              Int      @id @default(autoincrement())
  name            String
  price           Decimal  @db.Decimal(10, 2)
  unitType        UnitType @map("unit_type")
  defaultDuration Int      @default(45) @map("default_duration")
  iconUrl         String?  @map("icon_url")
  isActive        Boolean  @default(true) @map("is_active")

  orderItems OrderItem[]
  recipes    ServiceRecipe[] // Relation to Limit Recipe

  @@map("services")
}

model ServiceRecipe {
  id              Int @id @default(autoincrement())
  serviceId       Int @map("service_id")
  inventoryItemId Int @map("inventory_item_id")
  quantity        Int // Quantity in base unit (e.g., ml/gr)

  service       Service       @relation(fields: [serviceId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("service_recipes")
}

model Promo {
  id          Int       @id @default(autoincrement())
  code        String    @unique // e.g. "JUMAT10"
  description String?
  type        PromoType
  value       Decimal   @db.Decimal(10, 2)
  validUntil  DateTime? @map("valid_until")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  orders Order[]

  @@map("promos")
}

model StoreSetting {
  key   String @id
  value String @db.Text

  @@map("store_settings")
}

model Machine {
  id             Int           @id @default(autoincrement())
  name           String
  status         MachineStatus @default(IDLE)
  currentOrderId String?       @map("current_order_id")

  orders Order[]

  @@map("machines")
}

model Order {
  id            String  @id @default(uuid())
  invoiceNumber String  @unique @map("invoice_number")
  customerId    String  @map("customer_id")
  cashierId     String  @map("cashier_id")
  shiftId       String? @map("shift_id")
  machineId     Int?    @map("machine_id")

  // Gunakan 'StatusLaundry' bukan 'LaundryStatus'
  statusLaundry StatusLaundry @default(PENDING) @map("status_laundry")
  statusPayment PaymentStatus @default(UNPAID) @map("status_payment")
  paymentMethod PaymentMethod? @map("payment_method")
  
  promoId       Int?            @map("promo_id")
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(15, 2)

  totalAmount  Decimal @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount   Decimal @default(0) @map("paid_amount") @db.Decimal(15, 2)
  changeAmount Decimal @default(0) @map("change_amount") @db.Decimal(15, 2)
  note         String? // FR-OPS-06: Order Notes

  rackLocation String? @map("rack_location")

  washingStartedAt      DateTime? @map("washing_started_at")
  actualDurationMinutes Int?      @map("actual_duration_minutes")

  createdAt DateTime @default(now()) @map("created_at")

  customer   Customer    @relation(fields: [customerId], references: [id])
  cashier    User        @relation("CashierOrders", fields: [cashierId], references: [id])
  shift      Shift?      @relation(fields: [shiftId], references: [id])
  machine    Machine?    @relation(fields: [machineId], references: [id])
  promo      Promo?      @relation(fields: [promoId], references: [id])
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  serviceId Int?   @map("service_id")

  serviceNameSnapshot String  @map("service_name_snapshot")
  priceSnapshot       Decimal @map("price_snapshot") @db.Decimal(10, 2)

  quantity Float
  subtotal Decimal @db.Decimal(15, 2)

  order   Order    @relation(fields: [orderId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("order_items")
}

model Shift {
  id        String    @id @default(uuid())
  cashierId String    @map("cashier_id")
  startTime DateTime  @default(now()) @map("start_time")
  endTime   DateTime? @map("end_time")

  startCash Decimal @default(0) @map("start_cash") @db.Decimal(15, 2)

  systemExpectedCash Decimal? @map("system_expected_cash") @db.Decimal(15, 2)
  actualCashClosing  Decimal? @map("actual_cash_closing") @db.Decimal(15, 2)
  difference         Decimal? @db.Decimal(15, 2)

  cashier  User      @relation(fields: [cashierId], references: [id])
  expenses Expense[]
  orders   Order[]

  @@map("shifts")
}

model InventoryItem {
  id            Int    @id @default(autoincrement())
  name          String
  unit          String
  stockQuantity Int    @default(0) @map("stock_quantity")
  minStockAlert Int    @default(1) @map("min_stock_alert")
  isDeleted     Boolean @default(false) @map("is_deleted")

  expenses      Expense[]
  inventoryLogs InventoryLog[]
  recipes       ServiceRecipe[]

  @@map("inventory_items")
}

model Expense {
  id                     String          @id @default(uuid())
  shiftId                String          @map("shift_id")
  relatedInventoryItemId Int?            @map("related_inventory_item_id")
  category               ExpenseCategory
  amount                 Decimal         @db.Decimal(15, 2)
  note                   String?
  createdAt              DateTime        @default(now()) @map("created_at")

  shift         Shift          @relation(fields: [shiftId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [relatedInventoryItemId], references: [id])

  @@map("expenses")
}

model InventoryLog {
  id              String           @id @default(uuid())
  inventoryItemId Int              @map("inventory_item_id")
  changeAmount    Int              @map("change_amount")
  type            InventoryLogType
  actorId         String           @map("actor_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  actor         User          @relation(fields: [actorId], references: [id])

  @@map("inventory_logs")
}
